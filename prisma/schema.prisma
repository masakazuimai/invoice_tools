generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 自社情報
model CompanyProfile {
  id               String   @id @default(cuid())
  name             String // 会社名
  zipCode          String // 郵便番号
  address          String // 住所
  phone            String // 電話番号
  email            String // メールアドレス
  bankInfo         String // 振込先情報（JSON文字列）
  invoiceRegNumber String // 適格請求書発行事業者登録番号 (T+13桁)
  logoUrl          String? // ロゴ画像パス
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// 顧客
model Customer {
  id            String    @id @default(cuid())
  name          String // 顧客名（会社名）
  zipCode       String?
  address       String?
  phone         String?
  email         String?
  contactPerson String? // 担当者名
  memo          String?
  invoices      Invoice[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// 品目マスタ
model Item {
  id           String        @id @default(cuid())
  name         String // 品目名
  unitPrice    Int // 単価（円）
  unit         String        @default("個") // 単位
  taxRate      Int           @default(10) // 税率: 10 or 8
  description  String?
  invoiceItems InvoiceItem[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// 請求書
model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique // INV-YYYYMM-XXXX
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  issueDate     DateTime // 発行日
  dueDate       DateTime // 支払期限
  status        String        @default("draft") // draft, sent, paid, overdue
  subtotal      Int           @default(0) // 小計（税抜）
  taxAmount10   Int           @default(0) // 10%対象税額
  taxAmount8    Int           @default(0) // 8%対象税額
  totalAmount   Int           @default(0) // 合計金額（税込）
  notes         String? // 備考
  items         InvoiceItem[]
  sentAt        DateTime? // 送信日時
  paidAt        DateTime? // 入金日時
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// 請求書明細
model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  itemId    String?
  item      Item?   @relation(fields: [itemId], references: [id])
  name      String // 品目名（スナップショット）
  quantity  Int // 数量
  unit      String // 単位
  unitPrice Int // 単価
  taxRate   Int // 税率 10 or 8
  amount    Int // 金額（税抜）
  sortOrder Int     @default(0)
}
